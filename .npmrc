# pnpm's default isolated linker creates Windows directory junctions inside
# node_modules/.pnpm. Node 25's CommonJS resolver does not resolve those junctions when
# walking up for dependencies, so @vue/compiler-dom fell through to the hoisted
# @vue/compiler-core, whose "entities/decode" import then hit the hoisted entities@4
# (markdown-it's copy) instead of entities@7, crashing vue-tsc with
# ERR_PACKAGE_PATH_NOT_EXPORTED. A flat, real-directory layout resolves each package
# against its own dependencies, which is what every tool here expects.
node-linker=hoisted

# Keep the resolution deterministic across machines.
strict-peer-dependencies=false
